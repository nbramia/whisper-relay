# Copy to .env and fill in your machine-specific values (never commit .env):
#   cp .env.example .env
#
# Required for running locally. DEPLOY_* and TAILNET_* are also read by
# scripts/install-autostart.sh when enabling headless boot.
#
# By default Settings() reads only the process environment — a plain `.env`
# in the working directory is NOT read (issue #46). This matters when a
# checkout's WorkingDirectory is shared by more than one instance (see the
# "Co-located instances" note below): each instance's real environment (e.g.
# a systemd EnvironmentFile=) is authoritative, and a stray .env there must
# never fill in a key that instance's own file omits. For a bare local-dev
# `uvicorn` invocation with no EnvironmentFile=, opt in explicitly:
#   VOICE_GATEWAY_DOTENV=1
# (VOICE_GATEWAY_DOTENV_FILE overrides the path; defaults to ".env".)

VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=9788
LIFEOS_BASE_URL=http://127.0.0.1:8000

# LifeOS server-side (LifeOS .env — reverse proxy target; see docs/adr/005-lifeos-owned-chat-client.md)
# VOICE_GATEWAY_URL=http://127.0.0.1:9788

# Agent mode — OpenClaw voice-adapter (see docs/adr/004-dual-text-backends.md)
AGENT_BACKEND_URL=http://127.0.0.1:8100
# AGENT_BACKEND_TOKEN=
# AGENT_BACKEND_ENABLED=true

# Hermes mode — third text backend (see docs/adr/006-hermes-third-text-backend.md).
# The port is the Hermes LifeOS-adapter's own default (LIFEOS_ADAPTER_PORT in hermes
# lifeos_adapter/config.py); if that install overrides it, match it here.
HERMES_BACKEND_URL=http://127.0.0.1:8790
# HERMES_BACKEND_TOKEN=
# HERMES_BACKEND_ENABLED=true

TTS_BACKEND=kokoro
# See docs/adr/003-kokoro-tts-bm-george.md for Kokoro paths and voice settings

# Per-tenant backend routing — only for a single process serving more than one
# person (see docs/adr/008-per-tenant-backend-routing.md). Leave unset for a
# normal single-tenant install; the settings above are all you need.
# TENANT_BACKENDS_JSON={"taylor": {"tenant_token": "<openssl rand -hex 32>", "lifeos_base_url": "http://127.0.0.1:8002"}}

# Tailscale — optional reference URLs for your phone (see scripts/setup-tailscale.sh)
TAILNET_HTTPS_URL=https://your-machine.your-tailnet.ts.net
TAILNET_HTTP_PORT=8888

# systemd install (scripts/install-systemd-user.sh, scripts/install-systemd.sh)
DEPLOY_REPO_DIR=/path/to/whisper-relay
DEPLOY_ENV_FILE=/path/to/whisper-relay/.env
DEPLOY_UVICORN=uvicorn
DEPLOY_SYSTEMD_USER=your-linux-user
